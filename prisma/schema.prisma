datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

model Entry {
  id              Int         @id @default(autoincrement())
  date            DateTime    @default(now())
  title           String?
  content         String
  categoryId      Int?
  category        Category?   @relation(fields: [categoryId], references:[id])
}

model Category {
  id             Int         @id @default(autoincrement())
  name           String
  icon           String
  titleStyle     Title
  recordDateTime Boolean     @default(true)
  allowEdit      Boolean     @default(true)
  allowDelete    Boolean     @default(true)
  entries        Entry[]
}

enum Title{
  AUTO_NUMBER
  CUSTOM_TITLE
  CUSTOM_AND_AUTO
}